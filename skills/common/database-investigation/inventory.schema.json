{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Database investigation inventory",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "product",
    "schema",
    "target_id",
    "started_at",
    "finished_at",
    "status",
    "objects",
    "statistics",
    "evidence",
    "collections",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "design",
        "live"
      ]
    },
    "product": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed": {
      "type": [
        "object",
        "null"
      ]
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "statistics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/statistic"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/collection"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "evidence_ids"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "evidence_ids": {
            "$ref": "#/$defs/refs"
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^E[0-9]+$"
      }
    },
    "object": {
      "type": "object",
      "required": [
        "id",
        "catalog",
        "schema",
        "name",
        "kind",
        "columns",
        "constraints",
        "extensions",
        "evidence_ids"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "catalog": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "type",
              "ordinal",
              "nullable",
              "evidence_ids"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "ordinal": {
                "type": "integer",
                "minimum": 1
              },
              "nullable": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "evidence_ids": {
                "$ref": "#/$defs/refs"
              }
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "columns"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "primary_key",
                  "foreign_key",
                  "unique",
                  "check"
                ]
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "extensions": {
          "type": "object"
        },
        "evidence_ids": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "statistic": {
      "type": "object",
      "required": [
        "schema",
        "name",
        "metric",
        "value",
        "unit",
        "semantics",
        "granularity",
        "collected_at",
        "updated_at",
        "reset_at",
        "evidence_ids"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "semantics": {
          "enum": [
            "estimate",
            "measured",
            "cumulative"
          ]
        },
        "evidence_ids": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "collection": {
      "type": "object",
      "required": [
        "id",
        "status",
        "row_count",
        "truncated",
        "evidence_ids"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "empty",
            "permission_denied",
            "unsupported",
            "disabled",
            "timeout",
            "error",
            "not_collected"
          ]
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "evidence_ids": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^E[0-9]+$"
        },
        "kind": {
          "enum": [
            "file",
            "query"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "file"
              }
            }
          },
          "then": {
            "required": [
              "path",
              "sha256",
              "lines"
            ],
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "lines": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "query"
              }
            }
          },
          "then": {
            "required": [
              "query_id",
              "schema",
              "collected_at"
            ]
          }
        }
      ]
    }
  }
}
